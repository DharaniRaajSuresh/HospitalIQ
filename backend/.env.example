# Database — use SQLite (default) or PostgreSQL
# DATABASE_URL=sqlite:///./hospitaliq.db
# DATABASE_URL=postgresql://user:password@host:5432/hospitaliq_db
# POSTGRES_USER=hospitaliq
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=hospitaliq_db

# JWT — generate a strong random key for production
# SECRET_KEY=$(python -c "import secrets; print(secrets.token_hex(32))")
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth — required for Sign in with Google
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# Gemini AI — required for AI Copilot features
# GEMINI_API_KEY=your-gemini-api-key-here

# MLflow
# MLFLOW_TRACKING_URI=http://localhost:5000

# Redis
# REDIS_URL=redis://localhost:6379/0

# OpenTelemetry Tracing
# OTLP_ENDPOINT=http://localhost:4317
# SERVICE_NAME=hospitaliq-backend

# CORS
# CORS_ORIGINS=["http://localhost:8510","http://127.0.0.1:8510","http://localhost:8000"]

# Rate limiting
# RATE_LIMIT_PER_HOUR=1000

# App
# ENVIRONMENT=development
# DEBUG=true
# BACKEND_PORT=8000
# FRONTEND_PORT=8501
